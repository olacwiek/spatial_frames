# Chunk 1: setup
knitr::opts_chunk$set(echo = TRUE)
# Chunk 2: source setup
########## folders ##########
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
parentfolder <- dirname(getwd())
data          <- paste0(parentfolder, '/data/')
models        <- paste0(parentfolder, '/models/')
plots         <- paste0(parentfolder, '/plots/')
scripts       <- paste0(parentfolder, '/scripts/')
#################### packages ####################
library(tidyverse)
library(knitr)
# Bayesian
library(brms)
library(posterior)
library(tidybayes)
library(bayesplot)
library(bayestestR)   # optional ROPE cross-check
library(patchwork)
library(ggdist)
theme_set(theme_minimal(base_size = 12))
options(mc.cores = parallel::detectCores())
colorBlindBlack8  <- c("#000000", "#E69F00", "#56B4E9", "#009E73",
"#F0E442", "#0072B2", "#D55E00", "#CC79A7")
# Figure / Table caption helpers (manual numbering for HTML):
outputFormat = opts_knit$get("rmarkdown.pandoc.to");
if( is.null(outputFormat) ) outputFormat = "";
capTabNo = 1; capFigNo = 1;
capTab = function(x){
if(outputFormat == 'html'){
x = paste0("**Table ",capTabNo,".** ",x,"")
capTabNo <<- capTabNo + 1
}; x
}
capFig = function(x){
if(outputFormat == 'html'){
x = paste0("**Figure ",capFigNo,".** ",x,"")
capFigNo <<- capFigNo + 1
}; x
}
# Chunk 3: load models
model_files <- c("m_icon", "m_index", "m_success", "m_success_nostrat",
"m_repstrat_registered", "m_prop", "m_both", "m_combo")
missing <- model_files[!file.exists(paste0(models, model_files, ".rds"))]
if (length(missing) > 0)
stop("Missing model files in models/: ", paste(missing, collapse = ", "),
". Run 3_modeling.Rmd first.")
models_list <- set_names(
map(model_files, ~ readRDS(paste0(models, .x, ".rds"))),
model_files
)
# convenient handles
m_icon                <- models_list$m_icon
m_index               <- models_list$m_index
m_success             <- models_list$m_success
m_success_nostrat     <- models_list$m_success_nostrat
m_repstrat_registered <- models_list$m_repstrat_registered
m_prop                <- models_list$m_prop
m_both                <- models_list$m_both
m_combo               <- models_list$m_combo
# Chunk 4: load data
df <- readRDS(paste0(data, "df_prepared.rds")) %>%
mutate(item = story_id)     # 16-level item id for the by-item random effect
# Chunk 5: contrasts
# --- ±0.5 sum coding (equivalent to MASS::contr.sdif(2) for a 2-level factor) ---
contrasts(df$size)     <- matrix(c(-0.5, 0.5), nrow = 2,
dimnames = list(NULL, "compl"))  # element(-) / complete(+)
contrasts(df$distance) <- matrix(c(-0.5, 0.5), nrow = 2,
dimnames = list(NULL, "displ"))  # proximate(-) / displaced(+)
# --- derived variables ---
df <- df %>%
mutate(
icon_c  = icon  - 0.5,                       # centered strategy covariates (±0.5)
index_c = index - 0.5,
both    = as.integer(icon == 1 & index == 1) # icon-index co-occurrence indicator
)
# --- single-coded subset for the registered single-binary Model A ---
df_single <- df %>%
filter(strategy_combo %in% c("icon_only", "index_only")) %>%
droplevels() %>%
mutate(rep_strategy = as.integer(strategy_combo == "index_only"))  # 1 = index, 0 = icon
# re-apply contrasts after subsetting (droplevels can drop the attribute)
contrasts(df_single$size)     <- matrix(c(-0.5, 0.5), nrow = 2,
dimnames = list(NULL, "compl"))
contrasts(df_single$distance) <- matrix(c(-0.5, 0.5), nrow = 2,
dimnames = list(NULL, "displ"))
# Chunk 6: helpers
#################### preregistered ROPE bounds (log-odds) ####################
ROPE      <- 0.18   # primary half-width
ROPE_SENS <- 0.30   # sensitivity bound
#################### position of a 95% CrI relative to a ROPE ####################
rope_position <- function(lo, hi, r) {
if (hi < -r)                     "entirely below the ROPE"
else if (lo >  r)                "entirely above the ROPE"
else if (lo > -r && hi <  r)     "entirely within the ROPE"
else                             "straddling a ROPE boundary"
}
#################### one coefficient: median, 95% CrI, pd, ROPE position ####################
# Proportions are returned for both the primary and the sensitivity half-width,
# and p_dir is the probability of lying beyond the region in whichever direction
# the posterior favors, so that nothing reported in the prose has to be
# recomputed from the draws downstream.
rope_report <- function(fit, coef, rope = ROPE, sens = ROPE_SENS) {
d <- posterior::as_draws_df(fit)
if (!coef %in% names(d))
stop("Coefficient '", coef, "' not found. Available: ",
paste(grep("^b_", names(d), value = TRUE), collapse = ", "))
x  <- d[[coef]]
lo <- unname(quantile(x, 0.025))
hi <- unname(quantile(x, 0.975))
tibble(
coef             = coef,
m                = median(x),
lo               = lo,
hi               = hi,
pd               = max(mean(x > 0), mean(x < 0)),
pct_in_rope      = mean(x > -rope & x < rope),
p_above          = mean(x >  rope),
p_below          = mean(x < -rope),
p_dir            = max(mean(x > rope), mean(x < -rope)),
position         = rope_position(lo, hi, rope),
pct_in_rope_sens = mean(x > -sens & x < sens),
p_above_sens     = mean(x >  sens),
p_below_sens     = mean(x < -sens),
p_dir_sens       = max(mean(x > sens), mean(x < -sens)),
position_sens    = rope_position(lo, hi, sens)
)
}
#################### map a ROPE position to a preregistered decision ####################
# support_when: "below" | "above" | "within"  (the predicted relation to the ROPE)
# Unchanged: this implements the registered rule verbatim, including its
# treatment of a straddling interval as inconclusive.
rope_decision <- function(rep_row, support_when) {
pos <- rep_row$position
supported <- switch(support_when,
below  = pos == "entirely below the ROPE",
above  = pos == "entirely above the ROPE",
within = pos == "entirely within the ROPE")
if (isTRUE(supported))            "supported"
else if (grepl("straddling", pos)) "inconclusive"
else                              "not supported"
}
#################### tidy printer (rounded copy for display) ####################
# sens = FALSE keeps the console view at its previous width; the sensitivity
# proportions are still present in the underlying object either way.
show_rope <- function(rep_row, digits = 2, sens = FALSE) {
out <- rep_row %>%
mutate(across(c(m, lo, hi), ~ round(.x, digits)),
across(c(pd, pct_in_rope, p_above, p_below, p_dir,
pct_in_rope_sens, p_above_sens, p_below_sens, p_dir_sens),
~ round(.x, 3)))
if (isFALSE(sens))
out <- dplyr::select(out, -c(pct_in_rope_sens, p_above_sens,
p_below_sens, p_dir_sens))
out
}
#################### 2x2 design grid, with model contrasts ####################
design_grid <- df %>% dplyr::distinct(size, distance) %>% dplyr::arrange(size, distance)
#################### predicted cell probabilities (population level) ####################
# extra = named list of any additional predictors to hold fixed (e.g. icon_c = 0)
# Point estimate is the posterior median: a single unconstrained probability.
cell_probs <- function(fit, extra = NULL) {
nd <- design_grid
for (nm in names(extra)) nd[[nm]] <- extra[[nm]]
nd %>%
add_epred_draws(fit, re_formula = NA) %>%
group_by(size, distance) %>%
summarise(p  = median(.epred),
lo = quantile(.epred, 0.025),
hi = quantile(.epred, 0.975), .groups = "drop")
}
# Categorical version keeps the .category column. Point estimate is the
# posterior MEAN, not the median: within each draw the category probabilities
# sum to one, and averaging preserves that sum while taking medians does not.
# This is what makes the stacked configuration figure add to 100%.
cell_probs_cat <- function(fit) {
design_grid %>%
add_epred_draws(fit, re_formula = NA) %>%
group_by(size, distance, .category) %>%
summarise(p  = mean(.epred),
lo = quantile(.epred, 0.025),
hi = quantile(.epred, 0.975), .groups = "drop")
}
# Chunk 7: coef_map
coef_map <- map(models_list, ~ rownames(fixef(.x)))
coef_map
# Chunk 8: mcmc_trace
# Trace plots for the fixed effects of each confirmatory model. Chains should
# overlap and look like flat noise; any chain wandering off on its own, or a
# visible trend, would indicate a problem the numeric diagnostics missed.
trace_one <- function(fit, label) {
vars <- grep("^b_", brms::variables(fit), value = TRUE)
mcmc_plot(fit, type = "trace", variable = vars) +
ggtitle(label) +
theme(legend.position = "none", plot.title = element_text(face = "bold"))
}
trace_one(m_success, "Model B: communicative success")
trace_one(m_icon,    "Icon use (H2a)")
trace_one(m_index,   "Index use (H2b)")
# Rank histograms are a sharper check than trace plots: if the four chains are
# exploring the same posterior, each histogram is flat. Systematic steps or
# slopes indicate chains sitting in different places.
mcmc_plot(m_success, type = "rank_overlay",
variable = grep("^b_", brms::variables(m_success), value = TRUE)) +
ggtitle("Model B: rank histograms") +
theme(plot.title = element_text(face = "bold"))
# Numeric diagnostics for every model, recomputed here so the results document
# is self-contained rather than pointing back at 3_modeling.Rmd.
diag_tbl <- purrr::imap_dfr(models_list, function(fit, nm) {
sm <- posterior::summarise_draws(posterior::as_draws_df(fit),
"rhat", "ess_bulk", "ess_tail")
sm <- dplyr::filter(sm, !variable %in% c("lp__", "lprior"))
np <- bayesplot::nuts_params(fit)
tibble::tibble(
model        = nm,
n_obs        = nrow(fit$data),
rhat_max     = round(max(sm$rhat, na.rm = TRUE), 4),
ess_bulk_min = round(min(sm$ess_bulk, na.rm = TRUE)),
ess_tail_min = round(min(sm$ess_tail, na.rm = TRUE)),
divergent    = sum(np$Value[np$Parameter == "divergent__"]),
max_treedepth = sum(np$Value[np$Parameter == "treedepth__"] >= 12)
)
})
obs_cells <- bind_rows(
df %>% group_by(size, distance) %>%
summarise(obs = mean(correct_target, na.rm = TRUE), .groups = "drop") %>%
mutate(outcome = "success"),
df %>% group_by(size, distance) %>%
summarise(obs = mean(icon), .groups = "drop") %>%
mutate(outcome = "icon"),
df %>% group_by(size, distance) %>%
summarise(obs = mean(index), .groups = "drop") %>%
mutate(outcome = "index")
)
pred_all <- bind_rows(
h1_probs  %>% mutate(outcome = "success"),
h2a_probs %>% mutate(outcome = "icon"),
h2b_probs %>% mutate(outcome = "index")
) %>%
left_join(obs_cells, by = c("size", "distance", "outcome")) %>%
mutate(outcome = factor(outcome, levels = c("success", "icon", "index"),
labels = c("Communicative success", "Icon use", "Index use")))
m_success
h1        <- rope_report(m_success, "b_sizecompl")
h1_dec    <- rope_decision(h1, "below")           # complete < element
h1_probs  <- cell_probs(m_success, extra = list(icon_c = 0, index_c = 0))
show_rope(h1)
h2n     <- rope_report(m_success, "b_distancedispl")
h2n_dec <- rope_decision(h2n, "within")            # equivalence
show_rope(h2n)
h2n     <- rope_report(m_success, "b_distancedispl")
h2n_dec <- rope_decision(h2n, "within")            # equivalence
show_rope(h2n)
m_icon
h2a       <- rope_report(m_icon, "b_distancedispl")
h2a_dec   <- rope_decision(h2a, "above")           # displaced -> more icon
h2a_probs <- cell_probs(m_icon)
show_rope(h2a)
m_index
h2b       <- rope_report(m_index, "b_distancedispl")
h2b_int   <- rope_report(m_index, "b_sizecompl:distancedispl")
h2b_dec   <- rope_decision(h2b, "below")           # proximate -> more index
h2b_probs <- cell_probs(m_index)
show_rope(h2b)
obs_cells <- bind_rows(
df %>% group_by(size, distance) %>%
summarise(obs = mean(correct_target, na.rm = TRUE), .groups = "drop") %>%
mutate(outcome = "success"),
df %>% group_by(size, distance) %>%
summarise(obs = mean(icon), .groups = "drop") %>%
mutate(outcome = "icon"),
df %>% group_by(size, distance) %>%
summarise(obs = mean(index), .groups = "drop") %>%
mutate(outcome = "index")
)
pred_all <- bind_rows(
h1_probs  %>% mutate(outcome = "success"),
h2a_probs %>% mutate(outcome = "icon"),
h2b_probs %>% mutate(outcome = "index")
) %>%
left_join(obs_cells, by = c("size", "distance", "outcome")) %>%
mutate(outcome = factor(outcome, levels = c("success", "icon", "index"),
labels = c("Communicative success", "Icon use", "Index use")))
pd <- position_dodge(0.5)
p_cells <- ggplot(pred_all, aes(distance, p, colour = size, group = size)) +
geom_line(position = pd, linewidth = 1) +
geom_linerange(aes(ymin = lo, ymax = hi), position = pd, linewidth = 1.1) +
geom_point(position = pd, size = 4) +
geom_point(aes(y = obs), position = pd, size = 3.4, shape = 5, stroke = 1.1) +
facet_wrap(~ outcome) +
scale_colour_manual(values = colorBlindBlack8[c(4, 7)],
labels = c(element = "small", complete = "large")) +
scale_y_continuous(labels = scales::percent, limits = c(0, 1),
breaks = seq(0, 1, 0.25)) +
labs(x = NULL, y = "Probability", colour = "Referent size") +
theme_minimal(base_size = 18) +
theme(legend.position  = "bottom",
axis.text        = element_text(colour = "black"),
strip.text       = element_text(face = "bold"),
panel.grid.minor = element_blank(),
panel.spacing    = grid::unit(1.4, "lines"),
plot.background  = element_rect(fill = "white", colour = NA))
p_cells
ggsave(paste0(plots, "fig_cells.png"), p_cells, width = 11, height = 6.5, dpi = 600, bg = "white")
ggsave(paste0(plots, "fig_cells.svg"), p_cells, width = 11, height = 6.5, bg = "white")
# one row per item, carrying its design cell; strategy covariates at the midpoint
item_grid <- df %>%
distinct(item, story_id, target, size, distance) %>%
mutate(icon_c = 0, index_c = 0)
# re_formula keeps the by-item intercept but drops producer and guesser
item_post <- item_grid %>%
add_epred_draws(m_success, re_formula = ~ (1 | item)) %>%
group_by(item, story_id, target, size, distance) %>%
summarise(p  = median(.epred),
lo = quantile(.epred, 0.025),
hi = quantile(.epred, 0.975), .groups = "drop")
item_raw <- df %>%
group_by(story_id) %>%
summarise(obs = mean(correct_target, na.rm = TRUE),
n = n(), .groups = "drop")
item_tbl <- item_post %>%
left_join(item_raw, by = "story_id") %>%
mutate(target = fct_reorder(target, p))
p_items <- ggplot(item_tbl, aes(p, target, colour = size, shape = distance)) +
geom_linerange(aes(xmin = lo, xmax = hi), linewidth = 1, alpha = 0.85) +
geom_point(size = 4) +
geom_point(aes(x = obs), shape = 5, size = 3.4, stroke = 1.1) +
scale_colour_manual(values = colorBlindBlack8[c(4, 7)],
labels = c(element = "small", complete = "large")) +
scale_shape_manual(values = c(proximate = 16, displaced = 17)) +
scale_x_continuous(labels = scales::percent, limits = c(0, 1),
breaks = seq(0, 1, 0.25)) +
labs(x = "P(correct)", y = NULL,
colour = "Referent size", shape = "Spatial distance",
caption = "Open diamonds = observed proportion correct") +
theme_minimal(base_size = 17) +
theme(legend.position    = "bottom",
legend.box         = "vertical",
axis.text          = element_text(colour = "black"),
axis.text.y        = element_text(face = "bold"),
panel.grid.minor   = element_blank(),
panel.grid.major.y = element_line(colour = "grey92"),
plot.caption       = element_text(hjust = 0),
plot.background    = element_rect(fill = "white", colour = NA))
p_items
ggsave(paste0(plots, "fig_items.png"), p_items, width = 10, height = 9, dpi = 600, bg = "white")
ggsave(paste0(plots, "fig_items.svg"), p_items, width = 10, height = 9, bg = "white")
