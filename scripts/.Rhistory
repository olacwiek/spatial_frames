aes(fill = grp, group = grp),
concavity = 5, expand = unit(3, "mm"), radius = unit(3, "mm"),
alpha = 0.15, colour = NA, show.legend = FALSE) +
geom_segment(data = edges, aes(x, y, xend = xend, yend = yend),
colour = "grey75", linewidth = 0.3, inherit.aes = FALSE) +
geom_point(aes(colour = grp), size = 3) +
ggrepel::geom_text_repel(aes(label = concept, colour = grp),
size = 3.6, seed = 1, max.overlaps = Inf,
show.legend = FALSE) +
scale_colour_manual(values = pal, name = "Cluster (size, spread)") +
scale_fill_manual(values = pal) +
coord_equal() +
labs(title = "Semantic map of Polish concepts (ConceptNet Numberbatch)",
subtitle = sprintf("distance = 1 - cosine | layout: %s (stress %s, classical GOF %.0f%%) | grey line = nearest neighbour",
layout_used, stress_txt, gof),
x = NULL, y = NULL) +
theme(panel.grid = element_blank(), axis.text = element_blank(),
axis.ticks = element_blank(), legend.position = "right")
p
ggsave(paste0(plots, "semantic_map.png"), p, width = 9, height = 6.5, dpi = 300)
ggsave(paste0(plots, "semantic_map.pdf"), p, width = 9, height = 6.5)
ks  <- 2:7
sil <- sapply(ks, function(kk) mean(silhouette(cutree(hc, kk), d)[, 3]))
plot(ks, sil, type = "b", pch = 19,
xlab = "number of clusters (k)", ylab = "mean silhouette width",
main = "Suggested number of clusters")
cat("Silhouette suggests k =", ks[which.max(sil)], "\n")
plot(hc, hang = -1, main = "Hierarchical clustering (Ward)", xlab = "", sub = "")
rect.hclust(hc, k = k, border = "steelblue")
members  <- split(names(clusters), clusters)
sep_mean <- sapply(seq_along(members), function(i) {
m <- members[[i]]; others <- unlist(members[-i]); mean(D[m, others])
})
cluster_summary <- data.frame(
cluster          = names(members),
size             = lengths(members),
members          = vapply(members, paste, character(1), collapse = ", "),
mean_within_dist = round(within, 3),          # lower = denser
mean_separation  = round(sep_mean, 3),         # higher = more isolated
status           = ifelse(names(members) %in% cohesive, "cohesive", "peripheral"),
row.names = NULL
)
knitr::kable(cluster_summary[order(cluster_summary$mean_within_dist), ], row.names = FALSE,
caption = capTab("Clusters (k = 5): size, membership, density (within), separation, and whether cohesive enough to draw as a territory."))
knn <- 3
local_density <- apply(D, 1, function(row) mean(sort(row)[2:(knn + 1)]))  # 1st is self (0)
knitr::kable(
data.frame(concept = names(local_density),
knn_mean_dist = round(local_density, 3),
row.names = NULL)[order(local_density), ],
caption = capTab(sprintf("Local density (mean distance to %d nearest neighbours; lower = denser).", knn)))
nn <- t(sapply(rownames(D), function(i) {
row <- D[i, ]; row[i] <- Inf
