# re_formula keeps the by-item intercept but drops producer and guesser
item_post <- item_grid %>%
add_epred_draws(m_success, re_formula = ~ (1 | item)) %>%
group_by(item, story_id, target, size, distance) %>%
summarise(p  = median(.epred),
lo = quantile(.epred, 0.025),
hi = quantile(.epred, 0.975), .groups = "drop")
item_raw <- df %>%
group_by(story_id) %>%
summarise(obs = mean(correct_target, na.rm = TRUE),
n = n(), .groups = "drop")
item_tbl <- item_post %>%
left_join(item_raw, by = "story_id") %>%
mutate(target = fct_reorder(target, p))
p_items <- ggplot(item_tbl, aes(p, target, colour = size, shape = distance)) +
geom_linerange(aes(xmin = lo, xmax = hi), linewidth = 1, alpha = 0.85) +
geom_point(size = 4) +
geom_point(aes(x = obs), shape = 5, size = 3.4, stroke = 1.1) +
scale_colour_manual(values = colorBlindBlack8[c(4, 7)]) +
scale_shape_manual(values = c(proximate = 16, displaced = 17)) +
scale_x_continuous(labels = scales::percent, limits = c(0, 1),
breaks = seq(0, 1, 0.25)) +
labs(x = "P(correct)", y = NULL,
colour = "Referent size", shape = "Spatial distance",
caption = "Open diamonds = observed proportion correct") +
theme_minimal(base_size = 17) +
theme(legend.position    = "bottom",
legend.box         = "vertical",
axis.text          = element_text(colour = "black"),
axis.text.y        = element_text(face = "bold"),
panel.grid.minor   = element_blank(),
panel.grid.major.y = element_line(colour = "grey92"),
plot.caption       = element_text(hjust = 0),
plot.background    = element_rect(fill = "white", colour = NA))
